# Ensure a UTF-8 locale for all shells, including non-login/non-interactive ones.
if [ -z "$LANG" ]; then
  export LANG=C.UTF-8
fi

# Homebrew (must be early so brew-installed tools are found)
if [ -f /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Claude Code's shell snapshots don't capture chpwd/precmd hooks, so the
# `mise activate zsh` in .zshrc can't re-resolve tool versions when Claude
# cds into a project. Use shim-based activation only inside Claude Code.
if [ -n "$CLAUDECODE" ] && command -v mise &> /dev/null; then
  eval "$(mise activate zsh --shims)"
fi

export XDG_CONFIG_HOME="$HOME/.config"

# Machines with a small root filesystem can move the heavy tool caches onto
# another disk by writing an absolute path to ~/.config/dotfiles/cache_root (the
# same opt-in pattern as the `profile` and `machine_name` files). With no such
# file — the normal case — every tool keeps its default under $HOME.
#
# bin/install generates ~/.config/environment.d/10-cache-dirs.conf for the
# systemd user session; this zsh file covers plain TTY/SSH shells.
# See docs/disk-space.md.
_dotfiles_cache_root_file="${DOTFILES_CACHE_ROOT_FILE:-$HOME/.config/dotfiles/cache_root}"
if [ -r "$_dotfiles_cache_root_file" ]; then
  _dotfiles_cache_root="$(<"$_dotfiles_cache_root_file")"
  while [ "${_dotfiles_cache_root%/}" != "$_dotfiles_cache_root" ]; do
    _dotfiles_cache_root="${_dotfiles_cache_root%/}"
  done
  case "$_dotfiles_cache_root" in
    ""|/|*[!A-Za-z0-9_./-]*|[!/]*) ;;
    *)
      if [ -d "$_dotfiles_cache_root" ]; then
        _dotfiles_cache_root="$(cd "$_dotfiles_cache_root" && pwd -P)"
        if [ "$_dotfiles_cache_root" != / ]; then
          export GOMODCACHE="$_dotfiles_cache_root/go/mod"
          export GOCACHE="$_dotfiles_cache_root/go/build"
          export UV_CACHE_DIR="$_dotfiles_cache_root/uv"
          export PUPPETEER_CACHE_DIR="$_dotfiles_cache_root/puppeteer"
          export PLAYWRIGHT_BROWSERS_PATH="$_dotfiles_cache_root/ms-playwright"
          export npm_config_cache="$_dotfiles_cache_root/npm"
          export AURDEST="$_dotfiles_cache_root/yay"
        fi
      fi
      ;;
  esac
  unset _dotfiles_cache_root
fi
unset _dotfiles_cache_root_file

# Linux desktop and server use Codex; macOS selects its work profile locally.
if [ "$(uname)" = "Linux" ]; then
  export NOTCH_PROFILE="${NOTCH_PROFILE-personal}"
fi

export EDITOR="nvim"
export GOOSE_STATUS_HOOK="$HOME/.config/scripts/goose-hook"
_dotfiles_profile_file="${DOTFILES_PROFILE_FILE:-$HOME/.config/dotfiles/profile}"
_dotfiles_profile="${DOTFILES_PROFILE:-}"
if [ -z "$_dotfiles_profile" ] && [ -r "$_dotfiles_profile_file" ]; then
  _dotfiles_profile="$(<"$_dotfiles_profile_file")"
fi
if [ "${_dotfiles_profile:-desktop}" != "server" ]; then
  export OP_BIOMETRIC_UNLOCK_ENABLED=true
fi

# Point desktop/macOS shells at the dotfiles-managed fixed-socket ssh-agent.
# Server profile signs with a server-local key file instead, so leave
# SSH_AUTH_SOCK alone there unless a shell/session sets it explicitly.
if [ "${_dotfiles_profile:-desktop}" != "server" ]; then
  case "$(uname)" in
    Linux|Darwin)
      export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
      ;;
  esac
fi

unset _dotfiles_profile _dotfiles_profile_file

# Claude Code's shell snapshots don't capture chpwd_functions, so zoxide's
# doctor falsely warns on every cd. Silence it only inside Claude Code.
[ -n "$CLAUDECODE" ] && export _ZO_DOCTOR=0

export PATH="./bin:$HOME/.local/bin:$HOME/bin:$HOME/.config/scripts/:$PATH"
typeset -U PATH
