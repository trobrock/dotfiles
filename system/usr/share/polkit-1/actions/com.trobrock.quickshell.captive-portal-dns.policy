<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Trobrock dotfiles</vendor>
  <vendor_url>https://github.com/trobrock/dotfiles</vendor_url>
  <action id="com.trobrock.quickshell.captive-portal-dns">
    <description>Temporarily use Wi-Fi DNS for captive portal sign-in</description>
    <message>Authentication is required to change captive portal DNS routing</message>
    <icon_name>network-wireless</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/quickshell-captive-portal-dns</annotate>
  </action>
</policyconfig>
