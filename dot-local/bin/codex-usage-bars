#!/usr/bin/env python3
"""Print rectangular Codex and Claude usage pills for tmux.

The script reads local auth at runtime, fetches the providers' usage endpoints,
and caches the rendered status so tmux can call it every few seconds without
blocking on the network. Each pill sets its own background; downstream tmux
segments continue the chain by setting the next background directly.
"""

from __future__ import annotations

import datetime
import json
import math
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any
from typing import Callable

DEFAULT_TTL_SECONDS = 60
DEFAULT_TIMEOUT_SECONDS = 5
DEFAULT_CODEX_PROVIDER_TTL_SECONDS = 60
DEFAULT_CLAUDE_PROVIDER_TTL_SECONDS = 10 * 60
DEFAULT_API_SPEND_TTL_SECONDS = 10 * 60
DEFAULT_API_SPEND_DAYS = 7
DEFAULT_CCUSAGE_TIMEOUT_SECONDS = 30
DEFAULT_FAILURE_BACKOFF_SECONDS = 5 * 60
DEFAULT_RATE_LIMIT_BACKOFF_SECONDS = 30 * 60
JSON_REFRESH_WAIT_OVERHEAD_SECONDS = 1.0
JSON_REFRESH_POLL_SECONDS = 0.05

CODEX_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CLAUDE_TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
CLAUDE_CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
CLAUDE_KEYCHAIN_SERVICE = "Claude Code-credentials"

CACHE_VERSION = 9
JSON_SCHEMA_VERSION = 1
LOCK_MAX_AGE_SECONDS = 120
TOKEN_REFRESH_SKEW_SECONDS = 60
LOG_MAX_BYTES = 256 * 1024

# Pill styling uses the Catppuccin Mocha palette from tmux.conf.
PILL_BG_CODEX = "#313244"
PILL_BG_CLAUDE = "#45475a"
PILL_BG_APISPEND = "#313244"
PILL_FG_CODEX_LABEL = "#89b4fa"
PILL_FG_CLAUDE_LABEL = "#cba6f7"
PILL_FG_APISPEND_LABEL = "#a6e3a1"
PILL_FG_VALUE = "#cdd6f4"
PILL_FG_WARN = "#f9e2af"
PILL_FG_DANGER = "#f38ba8"
RESET_STYLE = "#[bg=default,fg=#cdd6f4]"
CODEX_ICON = "\ue795"
CLAUDE_ICON = "\U000f06a9"  # nf-md-robot
APISPEND_ICON = "\U000f0114"  # nf-md-cash


class UsageError(Exception):
    """Expected provider/auth/response issue while collecting usage."""


class HTTPUsageError(UsageError):
    """HTTP failure from a usage endpoint, without retaining its response body."""

    def __init__(
        self,
        status_code: int,
        url: str,
        retry_after_seconds: int | None = None,
    ):
        detail = f"HTTP {status_code} from {safe_endpoint_label(url)}"
        if retry_after_seconds is not None:
            detail += f" (Retry-After: {retry_after_seconds}s)"
        super().__init__(detail)
        self.status_code = status_code
        self.retry_after_seconds = retry_after_seconds


INSECURE_HTTP_OPT_IN = "CODEX_USAGE_BARS_ALLOW_INSECURE_HTTP"


def insecure_http_allowed() -> bool:
    """Allow HTTP only for explicit local test/development endpoint overrides."""
    return os.environ.get(INSECURE_HTTP_OPT_IN, "").casefold() in ("1", "true", "yes")


def _parsed_endpoint(url: str) -> urllib.parse.SplitResult:
    try:
        parsed = urllib.parse.urlsplit(url)
        # Accessing port also validates malformed and out-of-range ports.
        _ = parsed.port
    except (TypeError, ValueError) as error:
        raise UsageError("usage endpoint URL is invalid") from error
    if parsed.scheme.casefold() not in ("https", "http") or not parsed.hostname:
        raise UsageError("usage endpoint must be an absolute HTTP(S) URL")
    if parsed.username is not None or parsed.password is not None:
        raise UsageError("usage endpoint must not include user information")
    if "#" in url:
        raise UsageError("usage endpoint must not include a fragment")
    if parsed.scheme.casefold() != "https" and not insecure_http_allowed():
        raise UsageError(
            f"usage endpoint must use HTTPS ({INSECURE_HTTP_OPT_IN}=1 is only for local test/development)"
        )
    return parsed


def _endpoint_origin(parsed: urllib.parse.SplitResult) -> tuple[str, str, int]:
    scheme = parsed.scheme.casefold()
    default_port = 443 if scheme == "https" else 80
    return scheme, (parsed.hostname or "").casefold(), parsed.port or default_port


def safe_endpoint_label(url: str) -> str:
    """Return only a non-userinfo origin and path; never retain query data."""
    try:
        parsed = urllib.parse.urlsplit(url)
        host = parsed.hostname
        port = parsed.port
    except (TypeError, ValueError):
        return "usage endpoint"
    if not host or parsed.username is not None or parsed.password is not None:
        return "usage endpoint"
    host_label = f"[{host}]" if ":" in host else host
    default_port = 443 if parsed.scheme.casefold() == "https" else 80
    if port is not None and port != default_port:
        host_label += f":{port}"
    return f"{parsed.scheme.casefold()}://{host_label}{parsed.path or '/'}"


class SameOriginRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Permit redirects only within the validated endpoint origin.

    urllib's default handler copies Authorization and account headers to a new
    origin. Rejecting that redirect before a Request is created prevents those
    credentials from ever being forwarded.
    """

    def redirect_request(
        self,
        req: urllib.request.Request,
        fp: Any,
        code: int,
        msg: str,
        headers: Any,
        newurl: str,
    ) -> urllib.request.Request | None:
        absolute_url = urllib.parse.urljoin(req.full_url, newurl)
        source = _parsed_endpoint(req.full_url)
        destination = _parsed_endpoint(absolute_url)
        if _endpoint_origin(source) != _endpoint_origin(destination):
            raise UsageError("cross-origin usage endpoint redirect refused")
        return super().redirect_request(req, fp, code, msg, headers, absolute_url)


def env_int(name: str, default: int) -> int:
    value = os.environ.get(name)
    if value is None:
        return default
    try:
        return int(value)
    except ValueError:
        return default


def env_float(name: str, default: float) -> float:
    value = os.environ.get(name)
    if value is None:
        return default
    try:
        number = float(value)
    except ValueError:
        return default
    return number if math.isfinite(number) else default


def timeout_seconds() -> int:
    return env_int("CODEX_USAGE_BARS_TIMEOUT", DEFAULT_TIMEOUT_SECONDS)


def provider_ttl_seconds(provider: str) -> int:
    if provider == "claude":
        return env_int("CODEX_USAGE_BARS_CLAUDE_TTL", DEFAULT_CLAUDE_PROVIDER_TTL_SECONDS)
    if provider == "codex":
        return env_int("CODEX_USAGE_BARS_CODEX_TTL", DEFAULT_CODEX_PROVIDER_TTL_SECONDS)
    return DEFAULT_TTL_SECONDS


def failure_backoff_seconds(error: BaseException) -> int:
    if isinstance(error, HTTPUsageError) and error.status_code == 429:
        if error.retry_after_seconds is not None:
            return max(60, error.retry_after_seconds)
        return env_int("CODEX_USAGE_BARS_RATE_LIMIT_BACKOFF", DEFAULT_RATE_LIMIT_BACKOFF_SECONDS)
    return env_int("CODEX_USAGE_BARS_FAILURE_BACKOFF", DEFAULT_FAILURE_BACKOFF_SECONDS)


def usage_mode() -> str:
    mode = os.environ.get("CODEX_USAGE_BARS_MODE", "used").casefold()
    return mode if mode in ("used", "remaining") else "used"


def api_spend_mode() -> str:
    # auto: show only when no subscription pill has data (default)
    # on:   always show the API-spend pill
    # off:  never collect or show it
    mode = os.environ.get("CODEX_USAGE_BARS_API_SPEND", "auto").casefold()
    return mode if mode in ("auto", "on", "off") else "auto"


def api_spend_ttl_seconds() -> int:
    return env_int("CODEX_USAGE_BARS_API_SPEND_TTL", DEFAULT_API_SPEND_TTL_SECONDS)


def api_spend_days() -> int:
    return max(1, env_int("CODEX_USAGE_BARS_API_SPEND_DAYS", DEFAULT_API_SPEND_DAYS))


def ccusage_timeout_seconds() -> int:
    return env_int("CODEX_USAGE_BARS_CCUSAGE_TIMEOUT", DEFAULT_CCUSAGE_TIMEOUT_SECONDS)


def ccusage_command() -> list[str]:
    override = os.environ.get("CODEX_USAGE_BARS_CCUSAGE_CMD")
    if override:
        command = shlex.split(override)
        if command:
            return command
        raise UsageError("CODEX_USAGE_BARS_CCUSAGE_CMD is empty")
    binary = shutil.which("ccusage")
    if binary:
        return [binary]
    raise UsageError("ccusage is not installed")


def json_refresh_wait_seconds() -> float:
    """Return a coalescing budget covering the refresh's sequential operations."""
    # A refresh may make one Codex request, a Claude token refresh plus usage
    # request, and a ccusage subprocess. Keep the wait bounded by lock expiry.
    provider_budget = 3 * max(0, timeout_seconds())
    spend_budget = (
        max(0, ccusage_timeout_seconds()) if api_spend_mode() != "off" else 0
    )
    operation_budget = min(
        float(LOCK_MAX_AGE_SECONDS),
        provider_budget + spend_budget + JSON_REFRESH_WAIT_OVERHEAD_SECONDS,
    )
    if "CODEX_USAGE_BARS_JSON_REFRESH_WAIT" in os.environ:
        return max(
            0.0,
            env_float("CODEX_USAGE_BARS_JSON_REFRESH_WAIT", operation_budget),
        )
    return operation_budget


def cache_dir() -> Path:
    base = os.environ.get("XDG_CACHE_HOME")
    if base:
        return Path(base)
    return Path.home() / ".cache"


def cache_file() -> Path:
    override = os.environ.get("CODEX_USAGE_BARS_CACHE")
    if override:
        return Path(override).expanduser()
    return cache_dir() / "codex-usage-bars.json"


def lock_file() -> Path:
    return cache_file().with_suffix(".lock")


def log_file() -> Path:
    override = os.environ.get("CODEX_USAGE_BARS_LOG")
    if override:
        return Path(override).expanduser()
    return cache_dir() / "codex-usage-bars.log"


def codex_auth_file() -> Path:
    return Path(os.environ.get("CODEX_AUTH_FILE", "~/.codex/auth.json")).expanduser()


def pi_auth_file() -> Path:
    return Path(os.environ.get("CODEX_USAGE_BARS_PI_AUTH_FILE", "~/.local/share/pi/agent/auth.json")).expanduser()


def codex_usage_url() -> str:
    return os.environ.get("CODEX_USAGE_BARS_URL", CODEX_USAGE_URL)


def claude_usage_url() -> str:
    return os.environ.get("CLAUDE_USAGE_BARS_URL", CLAUDE_USAGE_URL)


def clamp_percent(value: float) -> float:
    return max(0.0, min(100.0, value))


def displayed_percent(used_percent: float | None) -> float | None:
    if used_percent is None:
        return None
    return clamp_percent(100.0 - used_percent if usage_mode() == "remaining" else used_percent)


def severity_color(percent: float, default: str) -> str:
    if percent >= 90:
        return PILL_FG_DANGER
    if percent >= 75:
        return PILL_FG_WARN
    return default


def render_pill(
    bg: str,
    label_fg: str,
    icon: str,
    percent: float | None,
    severity_percent: float | None = None,
) -> str:
    shown = displayed_percent(percent)
    if shown is None:
        value_str = "—"
        value_fg = label_fg
        icon_color_percent = None
    else:
        value_str = f"{shown:.0f}%"
        value_fg = severity_color(shown, PILL_FG_VALUE)
        icon_color_percent = displayed_percent(severity_percent)

    icon_fg = severity_color(icon_color_percent, label_fg) if icon_color_percent is not None else label_fg
    return (
        f"#[bg={bg},fg={icon_fg}] {icon} "
        f"#[fg={value_fg}]{value_str}"
        f"#[fg={label_fg}] "
    )


def format_dollars(value: float | None, decimals: int) -> str:
    number = _json_number(value)
    if number is None:
        return "\u2014"
    return f"${number:.{decimals}f}"


def render_api_spend_pill(total: float | None, days: int) -> str:
    total_str = format_dollars(total, 2)
    return (
        f"#[bg={PILL_BG_APISPEND},fg={PILL_FG_APISPEND_LABEL}] {APISPEND_ICON} "
        f"#[fg={PILL_FG_APISPEND_LABEL}]api "
        f"#[fg={PILL_FG_VALUE}]{total_str} "
        f"#[fg={PILL_FG_APISPEND_LABEL}]{days}d "
    )


def render_chain(
    codex_percent: float | None,
    claude_percent: float | None,
    codex_severity_percent: float | None = None,
    claude_severity_percent: float | None = None,
    api_spend: dict[str, Any] | None = None,
) -> str:
    pills = []
    if codex_percent is not None or codex_severity_percent is not None:
        pills.append(
            render_pill(
                PILL_BG_CODEX,
                PILL_FG_CODEX_LABEL,
                CODEX_ICON,
                codex_percent,
                codex_severity_percent,
            )
        )
    if claude_percent is not None or claude_severity_percent is not None:
        pills.append(
            render_pill(
                PILL_BG_CLAUDE,
                PILL_FG_CLAUDE_LABEL,
                CLAUDE_ICON,
                claude_percent,
                claude_severity_percent,
            )
        )
    if api_spend is not None:
        pills.append(
            render_api_spend_pill(api_spend.get("total"), api_spend_days())
        )
    if not pills:
        return ""
    return "".join((*pills, RESET_STYLE))


def parse_cached_percent(output: str, label: str) -> float | None:
    match = re.search(rf"\b{re.escape(label)}\b.*?(\d+(?:\.\d+)?)%", output, re.IGNORECASE)
    if not match:
        return None
    try:
        return float(match.group(1))
    except ValueError:
        return None


def cached_provider_metric(cached: dict[str, Any] | None, key: str, provider: str) -> float | None:
    if not cached:
        return None
    values = cached.get(key)
    if isinstance(values, dict):
        return _json_number(values.get(provider))
    return None


def cached_provider_percent(cached: dict[str, Any] | None, provider: str) -> float | None:
    values = cached.get("percentages") if cached else None
    if isinstance(values, dict) and provider in values:
        # A present malformed metric is rejected rather than silently revived
        # from the human-rendered output.
        return cached_provider_metric(cached, "percentages", provider)
    output = cached.get("output") if cached else None
    if isinstance(output, str):
        return parse_cached_percent(output, provider)
    return None


def cached_provider_severity_percent(cached: dict[str, Any] | None, provider: str) -> float | None:
    values = cached.get("severity_percentages") if cached else None
    if isinstance(values, dict) and provider in values:
        return cached_provider_metric(cached, "severity_percentages", provider)
    # Older caches without a five-hour metric must not present weekly usage as
    # though it came from the shorter window.
    return None


def cached_provider_state(cached: dict[str, Any] | None, provider: str) -> dict[str, Any]:
    if not cached:
        return {}
    states = cached.get("provider_state")
    if not isinstance(states, dict):
        return {}
    state = states.get(provider)
    return dict(state) if isinstance(state, dict) else {}


def should_skip_provider_fetch(provider: str, previous: dict[str, Any] | None, now: float) -> bool:
    if cached_provider_percent(previous, provider) is None:
        return False
    state = cached_provider_state(previous, provider)
    next_attempt_at = _json_number(state.get("next_attempt_at"))
    if next_attempt_at is not None and now < next_attempt_at:
        return True
    last_success_at = _json_number(state.get("last_success_at"))
    if last_success_at is not None and 0 <= now - last_success_at < provider_ttl_seconds(provider):
        return True
    return False


def sanitize_log_text(value: str) -> str:
    replacements = (
        # URL query strings can contain tokens even when they are not labelled.
        (re.compile(r"(https?://[^\s?#]+)(?:\?[^\s#]*)?(?:#[^\s]*)?", re.IGNORECASE), r"\1"),
        (re.compile(r"Bearer\s+[^\s,;]+", re.IGNORECASE), "Bearer <redacted>"),
        (re.compile(r"sk-ant-[A-Za-z0-9_-]+"), "sk-ant-<redacted>"),
        (re.compile(r"((?:access|refresh|id|api)[_-]?token[\"']?\s*[:=]\s*[\"'])[^\"'\s]+", re.IGNORECASE), r"\1<redacted>"),
    )
    for pattern, replacement in replacements:
        value = pattern.sub(replacement, value)
    return value[:1000]


def ensure_private_parent(path: Path) -> None:
    """Create the immediate parent privately; do not alter an existing directory."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)


def _trim_open_log(fd: int) -> None:
    size = os.fstat(fd).st_size
    if size <= LOG_MAX_BYTES:
        return
    tail_size = LOG_MAX_BYTES // 2
    tail = os.pread(fd, tail_size, max(0, size - tail_size))
    os.ftruncate(fd, 0)
    os.write(fd, tail)


def safe_append_log(path: Path, content: bytes) -> None:
    """Append to a private regular file without following a final symlink."""
    ensure_private_parent(path)
    flags = os.O_RDWR | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, 0o600)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError("refusing to write log to a non-regular file")
        # Existing user logs are kept, but made private before adding data.
        os.fchmod(fd, 0o600)
        _trim_open_log(fd)
        os.write(fd, content)
        _trim_open_log(fd)
    finally:
        os.close(fd)


def log_provider_failure(provider: str, error: BaseException) -> None:
    try:
        entry = {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "provider": provider,
            "error_type": type(error).__name__,
            "error": sanitize_log_text(str(error)),
        }
        line = (json.dumps(entry, separators=(",", ":")) + "\n").encode("utf-8")
        safe_append_log(log_file(), line)
    except OSError:
        pass


def request_json(url: str, headers: dict[str, str], data: dict[str, Any] | None = None) -> dict[str, Any]:
    _parsed_endpoint(url)
    body = json.dumps(data).encode("utf-8") if data is not None else None
    request = urllib.request.Request(
        url,
        data=body,
        headers=headers,
        method="POST" if data is not None else "GET",
    )
    opener = urllib.request.build_opener(SameOriginRedirectHandler())
    try:
        with opener.open(request, timeout=timeout_seconds()) as response:
            try:
                payload = json.loads(response.read().decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError):
                raise UsageError(
                    f"{safe_endpoint_label(url)} returned invalid JSON"
                ) from None
    except urllib.error.HTTPError as error:
        retry_after = None
        retry_after_header = error.headers.get("Retry-After") if error.headers else None
        if retry_after_header:
            try:
                retry_after = max(0, int(retry_after_header))
            except ValueError:
                retry_after = None
        # Do not read, retain, log, or chain an untrusted HTTP response body.
        error.close()
        raise HTTPUsageError(error.code, error.url or url, retry_after) from None
    if not isinstance(payload, dict):
        raise UsageError(f"{safe_endpoint_label(url)} returned non-object JSON")
    return payload


# Codex ---------------------------------------------------------------------


def select_codex_rate_limit(payload: dict[str, Any]) -> dict[str, Any] | None:
    selector = os.environ.get("CODEX_USAGE_BARS_LIMIT", "codex").casefold()
    if selector in ("", "codex", "default"):
        rate_limit = payload.get("rate_limit")
        if isinstance(rate_limit, dict):
            return rate_limit

    for item in payload.get("additional_rate_limits") or []:
        if not isinstance(item, dict):
            continue
        names = [
            str(item.get("metered_feature") or "").casefold(),
            str(item.get("limit_name") or "").casefold(),
        ]
        if selector in names or selector in " ".join(names):
            rate_limit = item.get("rate_limit")
            if isinstance(rate_limit, dict):
                return rate_limit

    if isinstance(payload.get("rate_limit"), dict):
        return payload["rate_limit"]

    for item in payload.get("additional_rate_limits") or []:
        if isinstance(item, dict) and isinstance(item.get("rate_limit"), dict):
            return item["rate_limit"]

    return None


def is_codex_window_seconds(window: dict[str, Any], target_seconds: float) -> bool:
    seconds = _json_number(window.get("limit_window_seconds"))
    if seconds is None:
        return False
    return target_seconds * 0.95 <= seconds <= target_seconds * 1.05


def is_codex_weekly_window(window: dict[str, Any]) -> bool:
    return is_codex_window_seconds(window, 7 * 24 * 60 * 60)


def is_codex_five_hour_window(window: dict[str, Any]) -> bool:
    return is_codex_window_seconds(window, 5 * 60 * 60)


def _extract_codex_window_used_percent(
    windows: list[dict[str, Any]],
    matcher: Callable[[dict[str, Any]], bool],
    *,
    label: str,
) -> float | None:
    window = next((window for window in windows if matcher(window)), None)
    if not isinstance(window, dict):
        return None
    used = _json_number(window.get("used_percent"))
    if used is None:
        raise UsageError(f"{label} did not include a finite numeric used_percent")
    return used


def read_codex_auth() -> tuple[str, str | None]:
    try:
        with codex_auth_file().open(encoding="utf-8") as handle:
            auth = json.load(handle)
        tokens = auth.get("tokens") or {}
        access_token = tokens.get("access_token")
        account_id = tokens.get("account_id")
    except FileNotFoundError:
        with pi_auth_file().open(encoding="utf-8") as handle:
            auth = json.load(handle)
        tokens = auth.get("openai-codex") or {}
        access_token = tokens.get("access")
        account_id = tokens.get("accountId")

    if not isinstance(access_token, str) or not access_token:
        raise UsageError("Codex ChatGPT access token is unavailable")
    if not isinstance(account_id, str):
        account_id = None
    return access_token, account_id


def fetch_codex_percents() -> tuple[float, float | None]:
    access_token, account_id = read_codex_auth()
    headers = {
        "Authorization": f"Bearer {access_token}",
        "User-Agent": "codex-cli",
    }
    if account_id:
        headers["ChatGPT-Account-ID"] = account_id

    payload = request_json(codex_usage_url(), headers)
    rate_limit = select_codex_rate_limit(payload)
    if not rate_limit:
        raise UsageError("Codex usage response did not include rate limits")

    windows = [
        window
        for window in (rate_limit.get("primary_window"), rate_limit.get("secondary_window"))
        if isinstance(window, dict)
    ]
    weekly = _extract_codex_window_used_percent(
        windows,
        is_codex_weekly_window,
        label="Codex weekly window",
    )
    if weekly is None:
        raise UsageError("Codex usage response did not include a weekly window")

    five_hour = _extract_codex_window_used_percent(
        windows,
        is_codex_five_hour_window,
        label="Codex five-hour window",
    )
    return weekly, five_hour


# Claude --------------------------------------------------------------------


def security_output(args: list[str], *, timeout: int = 4) -> str:
    try:
        return subprocess.check_output(
            ["security", *args],
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
        )
    except (FileNotFoundError, subprocess.SubprocessError) as error:
        raise UsageError(f"security {' '.join(args)} failed") from error


def claude_keychain_account() -> str | None:
    service = os.environ.get("CLAUDE_USAGE_BARS_KEYCHAIN_SERVICE", CLAUDE_KEYCHAIN_SERVICE)
    try:
        output = security_output(["find-generic-password", "-s", service])
    except UsageError:
        return os.environ.get("USER")
    match = re.search(r'"acct"<blob>="([^"]+)"', output)
    if match:
        return match.group(1)
    return os.environ.get("USER")


def claude_credentials_file() -> Path:
    return Path(os.environ.get("CLAUDE_USAGE_BARS_CREDENTIALS_FILE", "~/.claude/.credentials.json")).expanduser()


def read_claude_oauth() -> tuple[dict[str, Any], dict[str, Any], str | None]:
    env_token = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")
    if env_token:
        return {"claudeAiOauth": {"accessToken": env_token}}, {"accessToken": env_token}, None

    service = os.environ.get("CLAUDE_USAGE_BARS_KEYCHAIN_SERVICE", CLAUDE_KEYCHAIN_SERVICE)
    try:
        raw = security_output(["find-generic-password", "-s", service, "-w"])
        credentials = json.loads(raw)
        account = claude_keychain_account()
    except UsageError:
        path = claude_credentials_file()
        with path.open(encoding="utf-8") as handle:
            credentials = json.load(handle)
        account = f"file:{path}"

    if not isinstance(credentials, dict):
        raise UsageError("Claude credentials are not a JSON object")
    oauth = credentials.get("claudeAiOauth")
    if not isinstance(oauth, dict):
        raise UsageError("Claude credentials did not include claudeAiOauth")
    return credentials, oauth, account


def save_claude_oauth(credentials: dict[str, Any], account: str) -> None:
    if account.startswith("file:"):
        path = Path(account.removeprefix("file:"))
        tmp = path.with_suffix(path.suffix + ".tmp")
        with tmp.open("w", encoding="utf-8") as handle:
            json.dump(credentials, handle, separators=(",", ":"))
            handle.write("\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
        return

    service = os.environ.get("CLAUDE_USAGE_BARS_KEYCHAIN_SERVICE", CLAUDE_KEYCHAIN_SERVICE)
    payload = json.dumps(credentials, separators=(",", ":"))
    try:
        subprocess.check_call(
            ["security", "add-generic-password", "-U", "-s", service, "-a", account, "-w", payload],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=4,
        )
    except (FileNotFoundError, subprocess.SubprocessError) as error:
        raise UsageError("failed to update Claude keychain credentials") from error


def refresh_claude_oauth(credentials: dict[str, Any], oauth: dict[str, Any], account: str) -> str:
    refresh_token = oauth.get("refreshToken")
    if not isinstance(refresh_token, str) or not refresh_token:
        raise UsageError("Claude refresh token is unavailable")

    scopes = oauth.get("scopes")
    data: dict[str, Any] = {
        "grant_type": "refresh_token",
        "refresh_token": refresh_token,
        "client_id": str(oauth.get("clientId") or os.environ.get("CLAUDE_USAGE_BARS_CLIENT_ID") or CLAUDE_CLIENT_ID),
    }
    if isinstance(scopes, list) and scopes:
        data["scope"] = " ".join(str(scope) for scope in scopes)

    response = request_json(
        os.environ.get("CLAUDE_USAGE_BARS_TOKEN_URL", CLAUDE_TOKEN_URL),
        {"Content-Type": "application/json", "User-Agent": "claude-code"},
        data,
    )
    access_token = response.get("access_token")
    new_refresh_token = response.get("refresh_token")
    if not isinstance(access_token, str) or not isinstance(new_refresh_token, str):
        raise UsageError("Claude token refresh response did not include tokens")

    new_oauth = dict(oauth)
    new_oauth["accessToken"] = access_token
    new_oauth["refreshToken"] = new_refresh_token
    expires_in = response.get("expires_in")
    if not isinstance(expires_in, (int, float)):
        expires_in = 8 * 60 * 60
    new_oauth["expiresAt"] = int((time.time() + float(expires_in)) * 1000)
    if isinstance(response.get("scope"), str):
        new_oauth["scopes"] = response["scope"].split()

    credentials["claudeAiOauth"] = new_oauth
    save_claude_oauth(credentials, account)
    return access_token


def claude_access_token() -> str:
    credentials, oauth, account = read_claude_oauth()
    access_token = oauth.get("accessToken")
    if not isinstance(access_token, str) or not access_token:
        raise UsageError("Claude access token is unavailable")

    expires_at = oauth.get("expiresAt")
    if isinstance(expires_at, (int, float)):
        expires_at_seconds = float(expires_at) / 1000
        if expires_at_seconds <= time.time() + TOKEN_REFRESH_SKEW_SECONDS:
            if not account:
                raise UsageError("Claude token is expired and keychain account is unknown")
            return refresh_claude_oauth(credentials, oauth, account)

    return access_token


def _normalize_window_label(label: str) -> str:
    return re.sub(r"[^a-z0-9]+", "", label.casefold())


def is_claude_five_hour_window_key(label: str) -> bool:
    normalized = _normalize_window_label(label)
    return ("five" in normalized or "5" in normalized) and "hour" in normalized


def is_claude_weekly_window_key(label: str) -> bool:
    normalized = _normalize_window_label(label)
    return (
        ("seven" in normalized and "day" in normalized)
        or ("7day" in normalized)
        or ("week" in normalized)
    )


def _extract_claude_utilization(payload: dict[str, Any], label_matcher: Callable[[str], bool]) -> float | None:
    for key, value in payload.items():
        if not isinstance(key, str) or not isinstance(value, dict):
            continue
        utilization = _json_number(value.get("utilization"))
        if utilization is None:
            continue
        if label_matcher(key):
            return utilization
    return None


def fetch_claude_percents() -> tuple[float, float | None]:
    token = claude_access_token()
    payload = request_json(
        claude_usage_url(),
        {
            "Accept": "application/json",
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "User-Agent": "claude-code",
            "anthropic-beta": "oauth-2025-04-20",
        },
    )
    if not isinstance(payload, dict):
        raise UsageError("Claude usage response was not an object")

    weekly = _extract_claude_utilization(payload, is_claude_weekly_window_key)
    if weekly is None:
        raise UsageError("Claude usage response did not include a weekly window")

    five_hour = _extract_claude_utilization(payload, is_claude_five_hour_window_key)
    return weekly, five_hour


# API spend (Anthropic API, via ccusage local logs) ------------------------


def fetch_api_spend() -> float:
    today = datetime.date.today()
    since = (today - datetime.timedelta(days=api_spend_days() - 1)).strftime("%Y%m%d")
    command = [*ccusage_command(), "daily", "--json", "--offline", "--since", since]
    try:
        output = subprocess.check_output(
            command,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=ccusage_timeout_seconds(),
        )
    except (FileNotFoundError, subprocess.SubprocessError) as error:
        raise UsageError(f"ccusage invocation failed: {error}") from error

    try:
        data = json.loads(output)
    except json.JSONDecodeError as error:
        raise UsageError("ccusage did not return valid JSON") from error
    if not isinstance(data, dict):
        raise UsageError("ccusage returned non-object JSON")

    aggregate_total = None
    if "totals" in data:
        totals = data["totals"]
        if not isinstance(totals, dict):
            raise UsageError("ccusage totals data was not an object")
        aggregate_total = _json_number(totals.get("totalCost"))
        if aggregate_total is None:
            raise UsageError("ccusage totals included an invalid totalCost")

    daily_total = None
    if "daily" in data:
        days = data["daily"]
        if not isinstance(days, list):
            raise UsageError("ccusage daily data was not a list")

        costs = []
        for day in days:
            if not isinstance(day, dict):
                raise UsageError("ccusage daily data included an invalid row")
            cost = _json_number(day.get("totalCost"))
            if cost is None:
                raise UsageError("ccusage daily data included an invalid totalCost")
            costs.append(cost)

        daily_total = _json_number(sum(costs))
        if daily_total is None:
            raise UsageError("ccusage daily total was non-finite")

    if aggregate_total is not None:
        return aggregate_total
    if daily_total is not None:
        return daily_total
    raise UsageError("ccusage did not include a valid total or daily data")


def cached_api_spend(cached: dict[str, Any] | None) -> dict[str, Any] | None:
    if not cached:
        return None
    value = cached.get("api_spend")
    if isinstance(value, dict):
        total = _json_number(value.get("total"))
        if total is not None:
            return {"total": total}
    return None


def should_skip_api_spend(previous: dict[str, Any] | None, now: float) -> bool:
    state = cached_provider_state(previous, "apispend")
    next_attempt_at = _json_number(state.get("next_attempt_at"))
    if next_attempt_at is not None and now < next_attempt_at:
        return True
    if cached_api_spend(previous) is None:
        return False
    last_success_at = _json_number(state.get("last_success_at"))
    if last_success_at is not None and 0 <= now - last_success_at < api_spend_ttl_seconds():
        return True
    return False


def collect_api_spend(
    previous: dict[str, Any] | None = None,
) -> tuple[dict[str, Any] | None, dict[str, Any]]:
    if api_spend_mode() == "off":
        return None, {}
    now = time.time()
    previous_state = cached_provider_state(previous, "apispend")
    if should_skip_api_spend(previous, now):
        return cached_api_spend(previous), previous_state
    try:
        total = _json_number(fetch_api_spend())
        if total is None:
            raise UsageError("ccusage returned a bool or non-finite total")
        return {"total": total}, {
            "last_attempt_at": now,
            "last_success_at": now,
        }
    except (OSError, ValueError, UsageError, json.JSONDecodeError) as error:
        log_provider_failure("apispend", error)
        return cached_api_spend(previous), {
            **previous_state,
            "last_attempt_at": now,
            "last_error_at": now,
            "next_attempt_at": now + failure_backoff_seconds(error),
        }


# Status/cache ---------------------------------------------------------------


def collect_percentages(
    previous: dict[str, Any] | None = None,
) -> tuple[dict[str, float | None], dict[str, float | None], dict[str, dict[str, Any]]]:
    percentages: dict[str, float | None] = {}
    severity_percentages: dict[str, float | None] = {}
    provider_state: dict[str, dict[str, Any]] = {}
    for provider, fetcher in (
        ("codex", fetch_codex_percents),
        ("claude", fetch_claude_percents),
    ):
        now = time.time()
        previous_state = cached_provider_state(previous, provider)
        if should_skip_provider_fetch(provider, previous, now):
            percentages[provider] = cached_provider_percent(previous, provider)
            severity_percentages[provider] = cached_provider_severity_percent(previous, provider)
            provider_state[provider] = previous_state
            continue
        try:
            weekly_raw, five_hour_raw = fetcher()
            weekly = _json_number(weekly_raw)
            if weekly is None:
                raise UsageError(f"{provider} returned a bool or non-finite weekly metric")
            five_hour = None
            if five_hour_raw is not None:
                five_hour = _json_number(five_hour_raw)
                if five_hour is None:
                    raise UsageError(
                        f"{provider} returned a bool or non-finite five-hour metric"
                    )
            percentages[provider] = weekly
            severity_percentages[provider] = five_hour
            provider_state[provider] = {
                "last_attempt_at": now,
                "last_success_at": now,
            }
        except (OSError, ValueError, UsageError, urllib.error.URLError, json.JSONDecodeError) as error:
            log_provider_failure(provider, error)
            percentages[provider] = cached_provider_percent(previous, provider)
            severity_percentages[provider] = cached_provider_severity_percent(previous, provider)
            provider_state[provider] = {
                **previous_state,
                "last_attempt_at": now,
                "last_error_at": now,
                "next_attempt_at": now + failure_backoff_seconds(error),
            }
    return percentages, severity_percentages, provider_state


def collect_output(
    previous: dict[str, Any] | None = None,
) -> tuple[
    str,
    dict[str, float | None],
    dict[str, float | None],
    dict[str, dict[str, Any]],
    dict[str, Any] | None,
]:
    percentages, severity_percentages, provider_state = collect_percentages(previous)
    api_spend, api_spend_state = collect_api_spend(previous)
    provider_state = {**provider_state, "apispend": api_spend_state}

    has_subscription = (
        percentages.get("codex") is not None or percentages.get("claude") is not None
    )
    mode = api_spend_mode()
    show_api_spend = api_spend is not None and (
        mode == "on" or (mode == "auto" and not has_subscription)
    )

    return (
        render_chain(
            percentages.get("codex"),
            percentages.get("claude"),
            severity_percentages.get("codex"),
            severity_percentages.get("claude"),
            api_spend if show_api_spend else None,
        ),
        percentages,
        severity_percentages,
        provider_state,
        api_spend,
    )


def read_cache() -> dict[str, Any] | None:
    try:
        with cache_file().open(encoding="utf-8") as handle:
            cached = json.load(handle)
        if isinstance(cached, dict) and cached.get("version") == CACHE_VERSION:
            return cached
    except (OSError, json.JSONDecodeError):
        pass
    return None


def write_cache(
    output: str,
    percentages: dict[str, float | None],
    severity_percentages: dict[str, float | None],
    provider_state: dict[str, dict[str, Any]],
    api_spend: dict[str, Any] | None = None,
) -> None:
    path = cache_file()
    ensure_private_parent(path)
    data = {
        "version": CACHE_VERSION,
        "fetched_at": time.time(),
        "output": output,
        "percentages": percentages,
        "severity_percentages": severity_percentages,
        "provider_state": provider_state,
        "api_spend": api_spend,
    }
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    tmp = Path(tmp_name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            fd = -1
            json.dump(data, handle, allow_nan=False)
            handle.write("\n")
        os.replace(tmp, path)
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def acquire_lock() -> int | None:
    path = lock_file()
    ensure_private_parent(path)
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.write(fd, str(os.getpid()).encode("ascii"))
        return fd
    except FileExistsError:
        try:
            if time.time() - path.stat().st_mtime > LOCK_MAX_AGE_SECONDS:
                path.unlink()
                return acquire_lock()
        except OSError:
            return None
    except OSError:
        return None
    return None


def release_lock(fd: int | None) -> None:
    if fd is not None:
        try:
            os.close(fd)
        except OSError:
            pass
    try:
        lock_file().unlink()
    except OSError:
        pass


def refresh_cache() -> bool:
    fd = acquire_lock()
    if fd is None:
        return False
    try:
        previous = read_cache()
        output, percentages, severity_percentages, provider_state, api_spend = collect_output(previous)
        write_cache(output, percentages, severity_percentages, provider_state, api_spend)
        return True
    finally:
        release_lock(fd)


def spawn_refresh() -> None:
    try:
        subprocess.Popen(
            [sys.executable, __file__, "--refresh"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def cached_output_is_fresh(cached: dict[str, Any], ttl: int) -> bool:
    fetched_at = _json_number(cached.get("fetched_at"))
    return fetched_at is not None and 0 <= time.time() - fetched_at < ttl


def _json_number(value: Any) -> float | None:
    """Return a finite JSON-safe number without accepting booleans."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = float(value)
    return number if math.isfinite(number) else None


def _json_timestamp(value: Any) -> int | float | None:
    number = _json_number(value)
    if number is None or number < 0:
        return None
    return int(number) if number.is_integer() else number


def _json_window(used_percent: float | None, mode: str) -> dict[str, float | None]:
    used = _json_number(used_percent)
    if used is None:
        return {"used_percent": None, "display_percent": None}
    used = clamp_percent(used)
    display = clamp_percent(100.0 - used if mode == "remaining" else used)
    return {"used_percent": used, "display_percent": display}


def _json_health(state: dict[str, Any], available: bool, now: float) -> dict[str, Any]:
    """Whitelist non-sensitive provider state for widget consumers."""
    last_attempt = _json_timestamp(state.get("last_attempt_at"))
    last_success = _json_timestamp(state.get("last_success_at"))
    last_error = _json_timestamp(state.get("last_error_at"))
    next_attempt = _json_timestamp(state.get("next_attempt_at"))
    in_backoff = next_attempt is not None and now < next_attempt

    if in_backoff:
        status = "backoff"
    elif not available:
        status = "unavailable"
    elif last_error is not None and (last_success is None or last_error >= last_success):
        status = "degraded"
    else:
        status = "healthy"

    return {
        "status": status,
        "in_backoff": in_backoff,
        "last_attempt_at": last_attempt,
        "last_success_at": last_success,
        "last_error_at": last_error,
        "next_attempt_at": next_attempt,
    }


def _json_data_freshness(
    state: dict[str, Any], available: bool, now: float, ttl: int
) -> tuple[int | float | None, bool]:
    """Describe the age of retained data, independently of the cache file age."""
    data_at = _json_timestamp(state.get("last_success_at")) if available else None
    last_error = _json_timestamp(state.get("last_error_at"))
    stale = (
        not available
        or data_at is None
        or data_at > now
        or now - data_at >= ttl
        or (last_error is not None and last_error >= data_at)
    )
    return data_at, stale


def build_json_status(
    cached: dict[str, Any] | None,
    *,
    stale: bool,
    generated_at: float | None = None,
    refresh_error: str | None = None,
) -> dict[str, Any]:
    """Build the public, credential-free machine-readable status schema."""
    now = time.time() if generated_at is None else generated_at
    mode = usage_mode()
    providers: dict[str, dict[str, Any]] = {}
    provider_stale = False
    subscription_available = False
    for provider in ("codex", "claude"):
        weekly = cached_provider_percent(cached, provider)
        five_hour = cached_provider_severity_percent(cached, provider)
        available = weekly is not None or five_hour is not None
        subscription_available = subscription_available or available
        state = cached_provider_state(cached, provider)
        data_at, data_stale = _json_data_freshness(
            state, available, now, provider_ttl_seconds(provider)
        )
        provider_stale = provider_stale or data_stale
        providers[provider] = {
            "available": available,
            "data_at": data_at,
            "stale": data_stale,
            "weekly": _json_window(weekly, mode),
            "five_hour": _json_window(five_hour, mode),
            "health": _json_health(state, available, now),
        }

    payload: dict[str, Any] = {
        "schema_version": JSON_SCHEMA_VERSION,
        "generated_at": _json_timestamp(now),
        "fetched_at": _json_timestamp(cached.get("fetched_at")) if cached else None,
        "mode": mode,
        "cache_stale": stale,
        "stale": stale or provider_stale,
        "providers": providers,
    }
    if refresh_error:
        payload["refresh_error"] = refresh_error

    spend = cached_api_spend(cached)
    spend_mode = api_spend_mode()
    show_spend = spend is not None and (
        spend_mode == "on" or (spend_mode == "auto" and not subscription_available)
    )
    if show_spend:
        total = _json_number(spend.get("total"))
        if total is not None:
            spend_state = cached_provider_state(cached, "apispend")
            data_at, data_stale = _json_data_freshness(
                spend_state, True, now, api_spend_ttl_seconds()
            )
            payload["api_spend"] = {
                "total": total,
                "days": api_spend_days(),
                "data_at": data_at,
                "stale": data_stale,
                "health": _json_health(spend_state, True, now),
            }
            payload["stale"] = payload["stale"] or data_stale
    return payload


def render_json_status(
    cached: dict[str, Any] | None,
    *,
    stale: bool,
    refresh_error: str | None = None,
) -> str:
    """Serialize status as deterministic compact standards-compliant JSON."""
    return json.dumps(
        build_json_status(cached, stale=stale, refresh_error=refresh_error),
        sort_keys=True,
        separators=(",", ":"),
        allow_nan=False,
    )


def _cache_signature() -> tuple[int, int] | None:
    try:
        stat = cache_file().stat()
    except OSError:
        return None
    return stat.st_mtime_ns, stat.st_size


def synchronously_refresh_json_cache() -> tuple[dict[str, Any] | None, bool]:
    """Refresh once, or coalesce with the lock owner within an operation budget."""
    before = _cache_signature()
    try:
        refreshed = refresh_cache()
    except OSError:
        refreshed = False
    if refreshed:
        return read_cache(), True

    # A false return normally means another refresh owns the lock. Do not race
    # it by unlinking or starting a second process; wait for its atomic rewrite.
    if not lock_file().exists():
        return read_cache(), False
    deadline = time.monotonic() + json_refresh_wait_seconds()
    while time.monotonic() < deadline:
        current = _cache_signature()
        if current != before:
            cached = read_cache()
            if cached is not None:
                return cached, True
        if not lock_file().exists():
            cached = read_cache()
            return cached, cached is not None and _cache_signature() != before
        time.sleep(JSON_REFRESH_POLL_SECONDS)
    return read_cache(), False


def print_json_status(*, force_refresh: bool = False) -> int:
    """Print cached JSON, optionally waiting for one synchronous refresh."""
    ttl = env_int("CODEX_USAGE_BARS_TTL", DEFAULT_TTL_SECONDS)
    if force_refresh:
        cached, refresh_completed = synchronously_refresh_json_cache()
        cache_stale = (
            not refresh_completed
            or cached is None
            or not cached_output_is_fresh(cached, ttl)
        )
        refresh_error = (
            None
            if refresh_completed
            else "Usage refresh did not complete; retained data may be stale"
        )
        print(
            render_json_status(
                cached, stale=cache_stale, refresh_error=refresh_error
            )
        )
        return 0

    cached = read_cache()
    if cached is not None:
        cache_stale = not cached_output_is_fresh(cached, ttl)
        if cache_stale:
            spawn_refresh()
        print(render_json_status(cached, stale=cache_stale))
        return 0

    if refresh_cache():
        refreshed = read_cache()
        if refreshed is not None:
            cache_stale = not cached_output_is_fresh(refreshed, ttl)
            print(render_json_status(refreshed, stale=cache_stale))
            return 0

    spawn_refresh()
    print(render_json_status(None, stale=True))
    return 0


def print_status() -> int:
    cached = read_cache()
    ttl = env_int("CODEX_USAGE_BARS_TTL", DEFAULT_TTL_SECONDS)

    if cached and isinstance(cached.get("output"), str):
        if cached_output_is_fresh(cached, ttl):
            print(cached["output"])
        else:
            spawn_refresh()
            print(cached["output"])
        return 0

    if refresh_cache():
        refreshed = read_cache()
        if refreshed and isinstance(refreshed.get("output"), str):
            print(refreshed["output"])
            return 0

    spawn_refresh()
    print(render_chain(None, None))
    return 0


def main() -> int:
    args = sys.argv[1:]
    # Preserve the historical first-argument dispatch (including ignored
    # trailing arguments) while giving widgets one new synchronous command.
    if args and args[0] == "--refresh":
        return 0 if refresh_cache() else 1
    if args and args[0] == "--json":
        if len(args) > 1 and args[1] == "--refresh":
            return print_json_status(force_refresh=True)
        return print_json_status()
    return print_status()


if __name__ == "__main__":
    raise SystemExit(main())
