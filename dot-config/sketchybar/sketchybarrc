#!/usr/bin/env bash
# sketchybar, styled to match the Quickshell bar on the Linux machine.
#
# Layout mirrors dot-config/quickshell/Bar.qml:
#
#   left    workspaces (minimal: no pill, colored label + underline indicator)
#   center  upcoming calendar event, shown only when there is one
#   right   tailscale coffee bluetooth wifi mic battery | audio | clock
#
# The Linux bar also carries an AI-usage pill; it is intentionally omitted here.
#
# Quickshell uses "flat" BarGroups, so modules have no pill background of their
# own and are separated by 1px dividers instead. See components/BarGroup.qml.

ITEM_DIR="$CONFIG_DIR/items"
PLUGIN_DIR="$CONFIG_DIR/plugins"
SCRIPT_DIR="$CONFIG_DIR/scripts"

source "$CONFIG_DIR/theme.sh"

##### Bar appearance #####
# Bar.qml paints base at 43% alpha with a 1px surface1 bottom hairline.
#
# NOTE: sketchybar can only draw a border around the whole bar, not a single
# edge. Because the bar is flush with the top of the screen, the top and side
# edges land on the screen boundary and effectively only the bottom hairline
# reads as a visible line.
sketchybar --bar position=top \
                 height="$BAR_HEIGHT" \
                 color="$BAR_COLOR" \
                 border_width=1 \
                 border_color="$HAIRLINE" \
                 blur_radius=30 \
                 padding_left=8 \
                 padding_right=8

##### Defaults #####
# Quickshell uses CaskaydiaCove Nerd Font at 14px regular -- not bold -- for
# both glyphs and text, and tints modules with subtext by default.
default=(
  icon.font="$FONT_FAMILY:Regular:$FONT_SIZE.0"
  label.font="$FONT_FAMILY:Regular:$FONT_SIZE.0"
  icon.color="$SUBTEXT"
  label.color="$TEXT"
  padding_left=0
  padding_right=0
  icon.padding_left="$STATUS_PADDING"
  icon.padding_right="$STATUS_PADDING"
  label.padding_left=2
  label.padding_right=2
  background.drawing=off
  background.corner_radius="$RADIUS"
  background.height=25
  popup.background.color="$SURFACE_SOLID"
  popup.background.border_width=1
  popup.background.border_color="$SURFACE1"
  popup.background.corner_radius=8
  popup.background.shadow.drawing=on
  popup.blur_radius=20
  popup.horizontal=off
)
sketchybar --default "${default[@]}"

# components/BarDivider.qml: a thin surface1 line with 3px padding either side.
#
# NOTE: do not implement this as a 1px background. Setting `width` explicitly
# makes sketchybar ignore the item's padding during layout, so the line ends up
# flush against the neighbouring glyph.
divider() {
  sketchybar --add item "divider.$1" "$2" \
             --set "divider.$1" icon="$GLYPH_DIVIDER" \
                                icon.color="$SURFACE1" \
                                icon.padding_left="$DIVIDER_PADDING_LEFT" \
                                icon.padding_right="$DIVIDER_PADDING_RIGHT" \
                                label.drawing=off \
                                background.drawing=off
}

##### Left #####
source "$ITEM_DIR/workspaces.sh"

##### Center #####
source "$ITEM_DIR/calendar.sh"

##### Right #####
# Right-position items stack right-to-left in the order they are added, so this
# block is the reverse of the visual order documented at the top of the file.
source "$ITEM_DIR/clock.sh"
divider "audio" "right"
source "$ITEM_DIR/audio.sh"
divider "status" "right"
source "$ITEM_DIR/status.sh"

# The power menu is a hidden anchor for the alt-shift-esc popup; it draws
# nothing in the bar itself.
source "$ITEM_DIR/power.sh"

sketchybar --update
