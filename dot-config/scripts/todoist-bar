#!/usr/bin/env python3
"""Small Todoist API bridge for the desktop bars.

The API token comes from TODOIST_API_TOKEN or a private file outside this repo.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

API_ROOT = "https://api.todoist.com/api/v1"
TOKEN_FILE = Path.home() / ".config" / "dotfiles-secrets" / "todoist-api-token"
_xdg_cache = os.environ.get("XDG_CACHE_HOME", "").strip()
_cache_root = Path(_xdg_cache).expanduser() if _xdg_cache else Path.home() / ".cache"
if not _cache_root.is_absolute():
    _cache_root = Path.home() / ".cache"
CACHE_FILE = _cache_root / "todoist-bar" / "tasks.json"
FILTER = "overdue | today"


def token() -> str:
    value = os.environ.get("TODOIST_API_TOKEN", "").strip()
    if value:
        return value
    try:
        return TOKEN_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def request(path: str, *, method: str = "GET") -> Any:
    api_token = token()
    if not api_token:
        raise RuntimeError(
            "Set TODOIST_API_TOKEN or create ~/.config/dotfiles-secrets/todoist-api-token"
        )

    req = urllib.request.Request(
        API_ROOT + path,
        method=method,
        headers={"Authorization": f"Bearer {api_token}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as response:
            body = response.read()
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace").strip()
        raise RuntimeError(f"Todoist returned HTTP {error.code}: {detail[:240]}") from error
    except urllib.error.URLError as error:
        raise RuntimeError(f"Could not reach Todoist: {error.reason}") from error

    if not body:
        return None
    return json.loads(body)


def compact_task(task: dict[str, Any]) -> dict[str, Any]:
    due = task.get("due") if isinstance(task.get("due"), dict) else {}
    task_id = str(task.get("id", ""))
    return {
        "id": task_id,
        "content": str(task.get("content", "Untitled task")),
        "due": str(due.get("string") or due.get("date") or ""),
        "url": str(task.get("url") or f"https://app.todoist.com/app/task/{task_id}"),
        "priority": int(task.get("priority", 1)),
    }


def save_cache(payload: dict[str, Any]) -> None:
    CACHE_FILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    CACHE_FILE.parent.chmod(0o700)
    file_descriptor, temporary_name = tempfile.mkstemp(
        prefix=".tasks.", dir=CACHE_FILE.parent, text=True
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(file_descriptor, 0o600)
        with os.fdopen(file_descriptor, "w", encoding="utf-8") as cache:
            json.dump(payload, cache)
        temporary.replace(CACHE_FILE)
    finally:
        temporary.unlink(missing_ok=True)


def cached_error(message: str) -> dict[str, Any]:
    try:
        payload = json.loads(CACHE_FILE.read_text(encoding="utf-8"))
        if not isinstance(payload, dict):
            raise ValueError
        payload["stale"] = True
        payload["error"] = message
        return payload
    except (OSError, ValueError, json.JSONDecodeError):
        return {"count": 0, "tasks": [], "stale": False, "error": message}


def fetch() -> dict[str, Any]:
    try:
        raw_tasks: list[Any] = []
        cursor = ""
        while True:
            parameters: dict[str, Any] = {"query": FILTER, "limit": 200}
            if cursor:
                parameters["cursor"] = cursor
            response = request(f"/tasks/filter?{urllib.parse.urlencode(parameters)}")
            if isinstance(response, list):
                raw_tasks.extend(response)
                break
            if not isinstance(response, dict) or not isinstance(response.get("results"), list):
                raise RuntimeError("Todoist returned an unexpected task list")
            raw_tasks.extend(response["results"])
            next_cursor = response.get("next_cursor")
            cursor = str(next_cursor) if next_cursor else ""
            if not cursor:
                break
        tasks = [compact_task(item) for item in raw_tasks if isinstance(item, dict)]
        payload = {"count": len(tasks), "tasks": tasks, "stale": False, "error": ""}
        save_cache(payload)
        return payload
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        return cached_error(str(error))


def complete(task_id: str) -> dict[str, Any]:
    if not re.fullmatch(r"[A-Za-z0-9_-]+", task_id or ""):
        return {"ok": False, "error": "Invalid Todoist task ID"}
    try:
        request(f"/tasks/{task_id}/close", method="POST")
        return {"ok": True, "error": ""}
    except (RuntimeError, json.JSONDecodeError) as error:
        return {"ok": False, "error": str(error)}


def main() -> int:
    parser = argparse.ArgumentParser(description="Fetch and complete tasks for the top bar")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("fetch", help="print overdue and due-today tasks as JSON")
    complete_parser = subparsers.add_parser("complete", help="complete one task")
    complete_parser.add_argument("task_id")
    args = parser.parse_args()

    payload = fetch() if args.command == "fetch" else complete(args.task_id)
    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))
    return 0 if not payload.get("error") else 1


if __name__ == "__main__":
    sys.exit(main())
