#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PROFILE_FILE="${DOTFILES_PROFILE_FILE:-$HOME/.config/dotfiles/profile}"
DOTFILES_PROFILE="${DOTFILES_PROFILE:-desktop}"
ONLY_STOW=false

source "$SCRIPT_DIR/lib/logging.sh"
source "$SCRIPT_DIR/clean-broken-symlinks"

usage() {
  echo "Usage: $(basename "$0") [--profile desktop|server] [--only-stow]"
  echo ""
  echo "  --profile     Install profile to use. Defaults to \$DOTFILES_PROFILE or desktop."
  echo "                desktop: current GUI workstation behavior."
  echo "                server:  headless Arch profile; skips GUI packages/setup."
  echo "  --only-stow   Only run stow commands (skip package install, shell setup, etc.)"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --only-stow)
      ONLY_STOW=true
      shift
      ;;
    --profile)
      if [ -z "${2:-}" ]; then
        log_error "--profile requires one of: desktop, server"
        exit 1
      fi
      DOTFILES_PROFILE="$2"
      shift 2
      ;;
    --profile=*)
      DOTFILES_PROFILE="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      log_error "Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
done

validate_profile() {
  case "$DOTFILES_PROFILE" in
    desktop|server)
      ;;
    *)
      log_error "Unknown profile: $DOTFILES_PROFILE"
      log_error "Expected one of: desktop, server"
      exit 1
      ;;
  esac

  if [ "$DOTFILES_PROFILE" = "server" ] && [ "$(uname)" != "Linux" ]; then
    log_error "The server profile is only supported on Linux."
    exit 1
  fi
}

persist_profile() {
  mkdir -p "$(dirname "$PROFILE_FILE")"
  echo "$DOTFILES_PROFILE" > "$PROFILE_FILE"
}

is_desktop_profile() {
  [ "$DOTFILES_PROFILE" = "desktop" ]
}

stow_package() {
  local package="$1"
  stow --verbose=2 --dotfiles --no-folding --adopt -t "$HOME" -d "$REPO_DIR" "$package" 2>&1 | clean_stow_output
}

unstow_package() {
  local package="$1"
  if [ -d "$REPO_DIR/$package" ]; then
    stow --verbose=2 --dotfiles --no-folding -D -t "$HOME" -d "$REPO_DIR" "$package" 2>&1 | clean_stow_output || true
  fi
}

run_stow() {
  log "Installing dotfiles using stow..."
  source "$SCRIPT_DIR/lib/stow.sh"
  clean_absolute_symlinks
  stow_package .
  clean_broken_symlinks

  log "Installing platform/profile-specific dotfiles..."
  if [ "$(uname)" = "Darwin" ]; then
    unstow_package server
    stow_package darwin
  elif [ "$(uname)" = "Linux" ]; then
    if is_desktop_profile; then
      unstow_package server
      stow_package linux
    else
      unstow_package linux
      stow_package server
    fi
  fi
  clean_broken_symlinks
}

install_stow_check() {
  if [ -z "$(command -v stow)" ]; then
    log_error "stow is not installed. Run '$(basename "$0")' without --only-stow first."
    exit 1
  fi
}

validate_profile
persist_profile

if [ "$ONLY_STOW" = true ]; then
  install_stow_check
  run_stow
  exit 0
fi

install_package_manager() {
  if [ "$(uname)" = "Darwin" ]; then
    if [ -z "$(command -v brew)" ]; then
      log "Homebrew not found, installing..."
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
  elif [ "$(uname)" = "Linux" ]; then
    if [ -z "$(command -v yay)" ]; then
      log "yay not found, installing..."
      sudo pacman -S --noconfirm --needed git base-devel
      git clone https://aur.archlinux.org/yay.git /tmp/yay
      pushd /tmp/yay
      makepkg -si
      popd
      rm -rf /tmp/yay
    fi
  else
    log_error "Unsupported OS"
    exit 1
  fi
}

install_stow() {
  if [ -z "$(command -v stow)" ]; then
    log "stow not found, installing..."
    if [ "$(uname)" = "Darwin" ]; then
      brew install stow
    elif [ "$(uname)" = "Linux" ]; then
      yay -S --noconfirm stow
    else
      log_error "Unsupported OS for stow installation"
      exit 1
    fi
  fi
}

change_shell_to_zsh() {
  if [[ "$SHELL" != *"zsh" ]]; then
    if [ -z "$(command -v zsh)" ]; then
      log "zsh not found, installing..."
      if [ "$(uname)" = "Darwin" ]; then
        brew install zsh
      elif [ "$(uname)" = "Linux" ]; then
        yay -S --noconfirm zsh
      else
        log_error "Unsupported OS for zsh installation"
        exit 1
      fi
    fi

    log "Changing default shell to zsh..."
    chsh -s /usr/bin/zsh
    log "Default shell changed to zsh. Please logout and login again for changes to take effect."
    exit
  fi
}

init_tpm() {
  if [ ! -d "$HOME/.config/tmux/plugins" ] ; then
    log "Initializing Tmux Plugin Manager (TPM)..."
    git clone https://github.com/tmux-plugins/tpm "$HOME/.config/tmux/plugins/tpm"
  fi
}

init_goose() {
  if [ ! -d "$HOME/.config/goose" ] ; then
    mkdir -p "$HOME/.config/goose"
  fi
}

# 0x1002 is the AMD/ATI PCI vendor id. Read from sysfs rather than lspci so this
# works before pciutils is installed. Override with DOTFILES_AMD_GPU=1/0.
has_amd_gpu() {
  case "${DOTFILES_AMD_GPU:-}" in
    1) return 0 ;;
    0) return 1 ;;
    "") ;;
    *)
      log_error "DOTFILES_AMD_GPU must be 1 or 0, not '$DOTFILES_AMD_GPU'."
      exit 1
      ;;
  esac

  local vendor
  for vendor in /sys/class/drm/card*/device/vendor; do
    [ -r "$vendor" ] || continue
    if [ "$(cat "$vendor")" = "0x1002" ]; then
      return 0
    fi
  done

  return 1
}

archfile_packages() {
  local profile="${1:-$DOTFILES_PROFILE}"
  local amd_gpu=0

  if [ "$(uname)" = "Linux" ] && has_amd_gpu; then
    amd_gpu=1
  fi

  awk -v profile="$profile" -v amd_gpu="$amd_gpu" '
    /^[[:space:]]*#/ {
      desktop_section = ($0 ~ /\[desktop\]/)
      amd_section = ($0 ~ /\[amd\]/)
      next
    }
    /^[[:space:]]*$/ { next }
    profile == "server" && desktop_section { next }
    amd_section && amd_gpu != 1 { next }
    { print }
  ' "$REPO_DIR/Archfile"
}

archfile_lock_file() {
  if [ "$DOTFILES_PROFILE" = "server" ]; then
    echo "$REPO_DIR/Archfile.server.lock"
  else
    echo "$REPO_DIR/Archfile.lock"
  fi
}

install_packages() {
  log "Installing packages for $DOTFILES_PROFILE profile..."
  if [ "$(uname)" = "Darwin" ]; then
    brew bundle --file "$REPO_DIR/Brewfile"
  elif [ "$(uname)" = "Linux" ]; then
    local packages=()
    mapfile -t packages < <(archfile_packages)

    if [ ${#packages[@]} -eq 0 ]; then
      log_error "No Arch packages selected for $DOTFILES_PROFILE profile."
      exit 1
    fi

    archfile_remove_missing "${packages[@]}"
    yay -Syu --needed --noconfirm "${packages[@]}"
    archfile_write_lock "${packages[@]}"
  fi
}

archfile_write_lock() {
  local packages=("$@")

  {
    pacman -Qe "${packages[@]}" 2>/dev/null | awk '{print $1}'

    # Keep conditional AMD packages in the profile lock even when this machine
    # does not install them. One shared lock can then remove stale packages on
    # either GPU type without being rewritten differently by each machine.
    awk -v profile="$DOTFILES_PROFILE" '
      /^[[:space:]]*#/ {
        desktop_section = ($0 ~ /\[desktop\]/)
        amd_section = ($0 ~ /\[amd\]/)
        next
      }
      /^[[:space:]]*$/ { next }
      profile == "server" && desktop_section { next }
      amd_section { print }
    ' "$REPO_DIR/Archfile"
  } | sort -u > "$(archfile_lock_file)"
}

archfile_remove_missing() {
  local lock_file
  lock_file="$(archfile_lock_file)"

  if [ -f "$lock_file" ]; then
    local desired_packages
    desired_packages="$(mktemp)"
    printf '%s\n' "$@" > "$desired_packages"

    local packages=()
    while read -r package; do
      if grep -qxF "$package" "$desired_packages"; then
        continue
      fi

      # Skip lock entries that are already gone. pacman aborts the entire batch
      # on a single unknown target, which would block every valid removal.
      if ! pacman -Q "$package" >/dev/null 2>&1; then
        continue
      fi

      packages+=("$package")
    done < "$lock_file"
    rm -f "$desired_packages"

    if [ ${#packages[@]} -gt 0 ]; then
      log "Removing packages not in $(basename "$lock_file"): ${packages[*]}"
      yay -Rns --noconfirm "${packages[@]}"
    fi
  fi
}

mise_node_dir() {
  local node_dir

  if ! command -v mise >/dev/null 2>&1; then
    return 1
  fi

  node_dir="$(mise where -C "$HOME" node 2>/dev/null || true)"
  if [ -z "$node_dir" ]; then
    log "No global mise node; installing node@lts..."
    mise use -g node@lts
    node_dir="$(mise where -C "$HOME" node)"
  fi

  echo "$node_dir"
}

install_agent_browser() {
  local node_dir

  if [ "$(uname)" = "Darwin" ] && command -v brew >/dev/null 2>&1; then
    if ! command -v agent-browser >/dev/null 2>&1; then
      log "Installing agent-browser via Homebrew..."
      brew install agent-browser
    fi
  else
    if ! node_dir="$(mise_node_dir)"; then
      log_error "mise not found; cannot install agent-browser"
      return 1
    fi

    log "Installing agent-browser..."
    PATH="$node_dir/bin:$PATH" npm install -g --silent agent-browser

    # Make agent-browser visible to this script even if mise has not updated
    # the current shell's PATH yet.
    if [ -x "$node_dir/bin/agent-browser" ]; then
      export PATH="$node_dir/bin:$PATH"
    fi
  fi

  if command -v agent-browser >/dev/null 2>&1; then
    log "Installing agent-browser Chrome binary..."
    agent-browser install
  else
    log_error "agent-browser install appears to have failed; skipping browser install."
    return 1
  fi
}

install_notch() {
  if command -v notch >/dev/null 2>&1; then
    log "Updating notch..."
    notch upgrade
  else
    log "notch not found, installing..."
    curl --proto '=https' --proto-redir '=https' --tlsv1.2 -fsSL \
      https://raw.githubusercontent.com/trobrock/notch/main/install.sh | sh
  fi

  # Make notch visible to this script even if ~/.local/bin wasn't on PATH.
  if [ -z "$(command -v notch)" ] && [ -x "$HOME/.local/bin/notch" ]; then
    export PATH="$HOME/.local/bin:$PATH"
  fi

  if ! command -v notch >/dev/null 2>&1; then
    log_error "notch install appears to have failed."
    return 1
  fi

  log "Syncing Notch extensions..."
  notch extensions sync
}

install_developerly() {
  if [ -z "$(command -v developerly)" ]; then
    log "developerly not found, installing..."
    curl -fsSL https://raw.githubusercontent.com/getcomfortly/developerly-cli/main/install.sh | sh
  fi

  # Make developerly visible to this script even if ~/.local/bin isn't on PATH yet.
  if [ -z "$(command -v developerly)" ] && [ -x "$HOME/.local/bin/developerly" ]; then
    export PATH="$HOME/.local/bin:$PATH"
  fi

  if command -v developerly >/dev/null 2>&1; then
    log "Installing developerly hooks..."
    developerly hooks install
    log "Installing developerly skills..."
    developerly skill install --global --force
  else
    log_error "developerly install appears to have failed; skipping hooks/skills."
  fi
}

init_1password() {
  if [ "$(uname)" = "Linux" ]; then
    if [ ! -f "$HOME/.config/1Password/settings/settings.json" ] ; then
      log "enabling h/w acceleration for 1password..."
      mkdir -p "$HOME/.config/1Password/settings"
      cat > "$HOME/.config/1Password/settings/settings.json" <<JSON
{
  "version": 1,
  "app.useHardwareAcceleration": true,
  "app.theme": "dark",
  "browsers.extension.enabled": true
}
JSON
    fi
  fi
}

source "$SCRIPT_DIR/ss"

setup_fingerprint() {
  fingerprints=$(fprintd-list `whoami` | awk '/ - /{print $3}')
  if [ -n "$fingerprints" ]; then
    return
  fi

  log "Let's setup your right index finger as the first fingerprint.\nKeep moving the finger around on sensor until the process completes."
  sudo fprintd-enroll `whoami`

  log "Now let's verify that it's working correctly."

  if fprintd-verify; then
    log "Perfect! Now you can use your fingerprint on the lock screen (Super + Escape)."
  else
    log_error "Something went wrong. Maybe try again?"
  fi
}

allow_fingerprint_usage() {
  setup_fingerprint

  # Add fingerprint authentication as an option for sudo
  if ! grep -q pam_fprintd.so /etc/pam.d/sudo; then
    sudo sed -i '1i auth    sufficient pam_fprintd.so' /etc/pam.d/sudo
  fi

  # Add fingerprint authentication as an option for hyprpolkitagent
  if [ ! -f /etc/pam.d/polkit-1 ] || ! grep -q pam_fprintd.so /etc/pam.d/polkit-1; then
    sudo tee /etc/pam.d/polkit-1 >/dev/null <<'EOF'
auth      sufficient pam_fprintd.so
auth      sufficient pam_unix.so
auth      required   pam_deny.so

account   required pam_unix.so
password  required pam_unix.so
session   required pam_unix.so
EOF
  fi
}

setup_auto_login() {
  if [ ! -f /etc/systemd/system/getty@tty1.service.d/override.conf ]; then
    log "Setting up auto-login..."
    sudo mkdir -p /etc/systemd/system/getty@tty1.service.d
    sudo tee /etc/systemd/system/getty@tty1.service.d/override.conf >/dev/null <<EOF
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --autologin $USER --noclear %I \$TERM
EOF
  fi
}

setup_firewall() {
  log "Setting up firewall rules..."

  # Start and enable firewalld service
  sudo systemctl start firewalld
  sudo systemctl enable firewalld

  # Set default zone to public (equivalent to UFW's default deny incoming)
  if [ "$(sudo firewall-cmd --get-default-zone)" != "public" ]; then
    log "Setting default firewall zone to public..."
    sudo firewall-cmd --set-default-zone=public
  fi

  # Remove any existing SSH rules and add SSH (port 22)
  if sudo firewall-cmd --zone=public --list-all | grep -q 'services:.*ssh'; then
    log "Removing existing SSH rules from firewall..."
    sudo firewall-cmd --zone=public --remove-service=ssh --permanent 2>/dev/null || true
  fi
  if ! sudo firewall-cmd --zone=public --list-ports | grep -q '22/tcp'; then
    log "Adding SSH (port 22) to firewall rules..."
    sudo firewall-cmd --zone=public --add-port=22/tcp --permanent
  fi

  # Allow Syncthing web UI (port 8384) from Tailscale network only
  local syncthing_rule='rule family="ipv4" source address="100.64.0.0/10" port port="8384" protocol="tcp" accept'
  if ! sudo firewall-cmd --zone=public --list-rich-rules | grep -qF "$syncthing_rule"; then
    log "Adding Syncthing GUI (port 8384) for Tailscale to firewall rules..."
    sudo firewall-cmd --zone=public --add-rich-rule="$syncthing_rule" --permanent
  fi

  # Apply all permanent rules
  sudo firewall-cmd --reload

  log "Firewall setup complete. Default zone: public, SSH on 22, Syncthing GUI on 8384 (Tailscale only)."
}

setup_avahi() {
  log "Enabling Avahi network discovery service..."
  sudo systemctl enable --now avahi-daemon.service

  if ! sudo firewall-cmd --zone=public --query-service=mdns >/dev/null; then
    log "Allowing mDNS network discovery through the firewall..."
    sudo firewall-cmd --zone=public --add-service=mdns --permanent
    sudo firewall-cmd --reload
  fi
}

setup_captive_portal_assistant() {
  local helper_src="$REPO_DIR/system/usr/local/libexec/quickshell-captive-portal-dns"
  local policy_src="$REPO_DIR/system/usr/share/polkit-1/actions/com.trobrock.quickshell.captive-portal-dns.policy"

  if [ ! -f "$helper_src" ] || [ ! -f "$policy_src" ]; then
    log_error "Missing captive portal assistant files; skipping privileged DNS helper setup."
    return
  fi

  log "Installing captive portal DNS helper..."
  sudo /usr/bin/install -d -o root -g root -m 755 /usr/local/libexec
  sudo /usr/bin/install -o root -g root -m 755 "$helper_src" /usr/local/libexec/quickshell-captive-portal-dns
  sudo /usr/bin/install -d -o root -g root -m 755 /usr/share/polkit-1/actions
  sudo /usr/bin/install -o root -g root -m 644 "$policy_src" /usr/share/polkit-1/actions/com.trobrock.quickshell.captive-portal-dns.policy
}

setup_syncthing() {
  if ! command -v systemctl >/dev/null 2>&1; then
    log_error "systemctl not found; skipping syncthing user service setup."
    return
  fi

  if ! systemctl --user show-environment >/dev/null 2>&1; then
    log_error "No user systemd session available; skipping syncthing user service setup."
    return
  fi

  if ! systemctl --user is-enabled syncthing.service >/dev/null 2>&1; then
    log "Enabling syncthing user service..."
    if ! systemctl --user enable --now syncthing.service; then
      log_error "Could not enable syncthing user service."
    fi
  fi
}

setup_ssh_agent_linux() {
  if ! command -v systemctl >/dev/null 2>&1; then
    log_error "systemctl not found; skipping ssh-agent user service setup."
    return
  fi
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    log_error "No user systemd session available; skipping ssh-agent setup."
    return
  fi

  systemctl --user daemon-reload || true

  # Stowed user units show up as "linked" before they are enabled. Treat
  # only the literal "enabled" state as autostart-enabled; otherwise systemd
  # will know about the unit but won't create default.target.wants symlinks.
  if [ "$(systemctl --user is-enabled ssh-agent.service 2>/dev/null || true)" != "enabled" ]; then
    log "Enabling ssh-agent user service..."
    systemctl --user enable ssh-agent.service \
      || log_error "Could not enable ssh-agent.service."
  fi
  systemctl --user start ssh-agent.service \
    || log_error "Could not start ssh-agent.service."

  if [ "$(systemctl --user is-enabled ssh-agent-unlock.service 2>/dev/null || true)" != "enabled" ]; then
    log "Enabling ssh-agent-unlock user service..."
    systemctl --user enable ssh-agent-unlock.service \
      || log_error "Could not enable ssh-agent-unlock.service."
  fi
  systemctl --user restart ssh-agent-unlock.service \
    || log_error "Could not restart ssh-agent-unlock.service (is the sops-encrypted key in place?)."
}

cleanup_server_ssh_agent_linux() {
  if ! command -v systemctl >/dev/null 2>&1; then
    return
  fi
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    return
  fi

  systemctl --user daemon-reload || true

  for unit in ssh-agent-unlock.service ssh-agent.service ssh-agent.socket; do
    if systemctl --user list-unit-files "$unit" --no-legend 2>/dev/null | grep -q .; then
      log "Disabling $unit for server profile..."
      systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
    fi
  done
}

setup_ssh_agent_darwin() {
  local uid
  uid="$(id -u)"

  # (label -> log) pairs, agent first so its fixed socket exists before the
  # unlock agent tries to load the key into it.
  local labels=("com.trobrock.ssh-agent" "com.trobrock.ssh-agent-unlock")
  local logs=("/tmp/ssh-agent.log" "/tmp/ssh-agent-unlock.log")

  local i label plist
  for i in "${!labels[@]}"; do
    label="${labels[$i]}"
    plist="$HOME/Library/LaunchAgents/$label.plist"

    if [ ! -f "$plist" ]; then
      log_error "LaunchAgent plist missing at $plist; did stow run?"
      continue
    fi

    log "Reloading $label LaunchAgent..."
    launchctl bootout "gui/$uid/$label" 2>/dev/null || true
    if ! launchctl bootstrap "gui/$uid" "$plist" 2>/dev/null; then
      log_error "Could not load $label LaunchAgent; see ${logs[$i]}."
    fi
  done
}

setup_hyprshot_cleanup_cron() {
  local cron_job="0 2 * * * $HOME/.config/scripts/cleanup-hyprshot 30"
  
  # Check if the cron job already exists
  if crontab -l 2>/dev/null | grep -qF "cleanup-hyprshot"; then
    log "Hyprshot cleanup cron job already exists, skipping..."
    return
  fi
  
  log "Adding hyprshot cleanup cron job (daily at 2 AM, keeps 30 days)..."
  (crontab -l 2>/dev/null; echo "$cron_job") | crontab -
}

setup_github_user() {
  if [ -z "$(git config --global github.user)" ] && command -v gh >/dev/null 2>&1; then
    log "Setting github.user in git config..."
    local github_user
    github_user="$(gh api user --jq '.login' 2>/dev/null || true)"
    if [ -n "$github_user" ]; then
      git config --global github.user "$github_user"
    else
      log_error "Could not determine GitHub user from gh; skipping github.user setup."
    fi
  fi
}

ac_power_setting() {
  pmset -g custom | awk -v key="$1" '/^AC Power:/{flag=1; next} /^Battery Power:/{flag=0} flag && $1==key{print $2; exit}'
}

# AeroSpace + sketchybar + borders are the macOS stand-in for Hyprland and the
# Quickshell bar. AeroSpace has start-at-login in its own config and launches
# borders itself via after-startup-command, so this only has to cover the first
# run after a fresh install. See docs/macos-desktop.md.
setup_desktop_darwin() {
  if ! command -v brew >/dev/null 2>&1; then
    log_error "Homebrew not found; skipping macOS desktop setup."
    return
  fi

  if command -v sketchybar >/dev/null 2>&1; then
    if ! brew services list | grep -q '^sketchybar[[:space:]]\+started'; then
      log "Starting sketchybar service..."
      brew services start sketchybar
    fi
  else
    log_error "sketchybar not installed; run brew bundle first."
  fi

  if [ -d /Applications/AeroSpace.app ]; then
    if ! pgrep -f '/Applications/AeroSpace.app/Contents/MacOS/AeroSpace' >/dev/null 2>&1; then
      log "Starting AeroSpace..."
      open -a AeroSpace
    fi
  else
    log_error "AeroSpace not installed; run brew bundle first."
  fi
}

setup_power_management() {
  if [ "$(ac_power_setting sleep)" != "0" ]; then
    log "Disabling system sleep on AC power so SSH stays reachable..."
    sudo pmset -c sleep 0
  fi
  if [ "$(ac_power_setting disksleep)" != "0" ]; then
    log "Disabling disk sleep on AC power so SSH logins don't stall waking disks..."
    sudo pmset -c disksleep 0
  fi

  setup_caffeinate_daemon
}

# The pmset calls above are best-effort: on MDM-managed machines an Intune
# EnergySaver payload in /Library/Managed Preferences/com.apple.MCX.plist
# forces "System Sleep Timer = 20" and silently reverts them at every MDM
# check-in. Power assertions aren't revocable by MDM, so we also hold a
# permanent `caffeinate -s` assertion, which is only valid on AC power.
# See the comment block in the plist for the full rationale.
setup_caffeinate_daemon() {
  local label="com.trobrock.caffeinate-ac"
  local src="$REPO_DIR/system/Library/LaunchDaemons/$label.plist"
  local dest="/Library/LaunchDaemons/$label.plist"
  local script_src="$REPO_DIR/system/usr/local/bin/caffeinate-ac"
  local script_dest="/usr/local/bin/caffeinate-ac"

  if [ ! -f "$src" ] || [ ! -f "$script_src" ]; then
    log_error "Missing caffeinate-ac sources; skipping caffeinate daemon setup."
    return
  fi

  log "Installing $label LaunchDaemon (keeps machine awake on AC power)..."
  # Absolute paths: this repo's bin/ is on PATH and `install` would otherwise
  # resolve to this very script instead of /usr/bin/install.
  sudo /usr/bin/install -d -o root -g wheel -m 755 /usr/local/bin
  sudo /usr/bin/install -o root -g wheel -m 755 "$script_src" "$script_dest"
  sudo /usr/bin/install -o root -g wheel -m 644 "$src" "$dest"

  sudo /bin/launchctl bootout "system/$label" 2>/dev/null || true
  if ! sudo /bin/launchctl bootstrap system "$dest" 2>/dev/null; then
    log_error "Could not load $label LaunchDaemon."
  fi
}

install_pacman_hooks() {
  log "Installing pacman hooks..."
  sudo mkdir -p /etc/pacman.d/hooks
  sudo cp "$REPO_DIR/hooks/"*.hook /etc/pacman.d/hooks/
}

register_desktop_protocol_handlers() {
  if ! command -v xdg-mime >/dev/null 2>&1; then
    log_error "xdg-mime not found; skipping desktop protocol handler registration."
    return
  fi

  log "Registering Zoom web app protocol handlers..."
  xdg-mime default Zoom.desktop x-scheme-handler/zoommtg
  xdg-mime default Zoom.desktop x-scheme-handler/zoomus

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
  fi
}

setup_voxtype_soniox() {
  log "Building custom VoxType with Soniox support..."
  "$SCRIPT_DIR/build-voxtype-soniox"
}

setup_voxtype_service() {
  if [ ! -x /usr/local/bin/voxtype ]; then
    log_error "Custom VoxType binary not found at /usr/local/bin/voxtype; skipping service setup."
    return
  fi

  if ! command -v systemctl >/dev/null 2>&1; then
    log_error "systemctl not found; skipping VoxType user service setup."
    return
  fi

  if ! systemctl --user show-environment >/dev/null 2>&1; then
    log_error "No user systemd session available; skipping VoxType user service setup."
    return
  fi

  systemctl --user daemon-reload || true

  # Stowed user units show up as "linked" before they are enabled. Treat
  # only the literal "enabled" state as autostart-enabled; otherwise systemd
  # will know about the unit but won't create graphical-session.target.wants.
  if [ "$(systemctl --user is-enabled voxtype.service 2>/dev/null || true)" != "enabled" ]; then
    log "Enabling VoxType user service..."
    systemctl --user enable voxtype.service \
      || log_error "Could not enable voxtype.service."
  fi

  systemctl --user start voxtype.service \
    || log_error "Could not start voxtype.service."
}

setup_laptop_sleep() {
  if compgen -G "/sys/class/power_supply/BAT*" >/dev/null; then
    log "Configuring laptop sleep/hibernate..."
    "$SCRIPT_DIR/setup-laptop-sleep"
  else
    log "No laptop battery detected; skipping laptop sleep/hibernate setup."
  fi
}

# Cap the journal. The default allows journald to use up to 10% of the
# filesystem, subject to a 4G default cap. The drop-in uses a smaller percentage
# so it scales to whatever disk the machine actually has.
setup_journal_limits() {
  local src="$REPO_DIR/system/etc/systemd/journald.conf.d/70-size-limits.conf"
  local dest=/etc/systemd/journald.conf.d/70-size-limits.conf

  if [ ! -f "$src" ]; then
    log_error "Missing $src; skipping journal size limits."
    return
  fi

  if sudo cmp -s "$src" "$dest" 2>/dev/null; then
    return
  fi

  log "Installing journal size limits..."
  sudo install -Dm644 "$src" "$dest"
  sudo systemctl restart systemd-journald || log_error "Could not restart systemd-journald."
}

# Point pacman's package cache at $1. Only called when a machine has opted into
# cache relocation; on a box with room on root, pacman keeps its default.
setup_pacman_cache_dir() {
  local target="$1"
  local conf=/etc/pacman.conf
  local marker=/etc/pacman.d/dotfiles-cache-root
  local current

  current="$(pacman-conf CacheDir 2>/dev/null | head -1)"
  if [ "${current%/}" != "$target" ]; then
    log "Pointing pacman's package cache at $target..."
    sudo install -d -o root -g root -m 755 "$target"

    if grep -qE '^[[:space:]]*CacheDir[[:space:]]*=' "$conf"; then
      sudo sed -i -E "s|^[[:space:]]*CacheDir[[:space:]]*=.*|CacheDir = $target|" "$conf"
    else
      sudo sed -i -E "s|^#CacheDir[[:space:]]*=.*|CacheDir = $target|" "$conf"
    fi
  fi

  current="$(pacman-conf CacheDir 2>/dev/null | head -1)"
  if [ "${current%/}" != "$target" ]; then
    log_error "pacman CacheDir is still '${current}'; set it to $target in $conf by hand."
    return 1
  fi

  printf '%s\n' "$target" | sudo tee "$marker" >/dev/null
}

restore_pacman_cache_dir() {
  local conf=/etc/pacman.conf
  local default=/var/cache/pacman/pkg
  local marker=/etc/pacman.d/dotfiles-cache-root
  local managed current

  [ -r "$marker" ] || return 0
  managed="$(sudo cat "$marker")"
  current="$(pacman-conf CacheDir 2>/dev/null | head -1)"

  # Only undo the value we set. Leave a later manual change alone.
  if [ "${current%/}" = "${managed%/}" ]; then
    log "Restoring pacman's default package cache..."
    sudo sed -i -E "s|^[[:space:]]*CacheDir[[:space:]]*=.*|CacheDir = $default|" "$conf"
    current="$(pacman-conf CacheDir 2>/dev/null | head -1)"
    if [ "${current%/}" != "$default" ]; then
      log_error "Could not restore pacman CacheDir to $default."
      return 1
    fi
  fi

  sudo rm -f "$marker"
}

# paccache.timer ships with pacman-contrib and trims the cache to the last 3
# versions of each package weekly.
setup_paccache_timer() {
  if [ ! -f /usr/lib/systemd/system/paccache.timer ]; then
    log_error "paccache.timer not found; is pacman-contrib installed?"
    return
  fi

  if systemctl is-enabled paccache.timer >/dev/null 2>&1; then
    return
  fi

  log "Enabling weekly pacman cache trim (paccache.timer)..."
  sudo systemctl enable --now paccache.timer \
    || log_error "Could not enable paccache.timer."
}

# Machines with a small root filesystem can move the heavy tool caches onto
# another disk by writing an absolute path to ~/.config/dotfiles/cache_root —
# the same opt-in pattern as the `profile` and `machine_name` files. Most
# machines have no such file, and every tool keeps its default under $HOME.
# See docs/disk-space.md.
cache_root() {
  local file="${DOTFILES_CACHE_ROOT_FILE:-$HOME/.config/dotfiles/cache_root}"
  local root

  [ -r "$file" ] || return 1
  root="$(<"$file")"
  while [ "${root%/}" != "$root" ]; do
    root="${root%/}"
  done

  # Keep this value safe to use in pacman.conf, environment.d, and sed. A cache
  # root should be a simple absolute path, never the filesystem root itself.
  case "$root" in
    ""|/|*[!A-Za-z0-9_./-]*|[!/]*)
      log_error "cache_root must be a simple absolute path other than '/': $file"
      return 2
      ;;
  esac

  echo "$root"
}

setup_cache_relocation() {
  local generated="$HOME/.config/environment.d/10-cache-dirs.conf"
  local root status

  if root="$(cache_root)"; then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      return 1
    fi

    # Not opted in. Clear state generated by a previous run.
    if [ -f "$generated" ]; then
      log "No cache_root configured; removing stale $generated."
      rm -f "$generated"
    fi
    restore_pacman_cache_dir
    return 0
  fi

  if [ ! -d "$root" ]; then
    log_error "cache_root '$root' is not a directory; refusing to install into root-backed caches."
    if [ -f "$generated" ]; then
      log "Removing stale $generated."
      rm -f "$generated"
    fi
    return 1
  fi

  root="$(cd "$root" && pwd -P)"
  if [ "$root" = / ]; then
    log_error "cache_root resolves to '/'; refusing to place caches on the root filesystem."
    if [ -f "$generated" ]; then
      log "Removing stale $generated."
      rm -f "$generated"
    fi
    return 1
  fi

  log "Relocating tool caches to $root..."
  mkdir -p \
    "$root/go/mod" \
    "$root/go/build" \
    "$root/uv" \
    "$root/puppeteer" \
    "$root/ms-playwright" \
    "$root/npm" \
    "$root/yay"

  export GOMODCACHE="$root/go/mod"
  export GOCACHE="$root/go/build"
  export UV_CACHE_DIR="$root/uv"
  export PUPPETEER_CACHE_DIR="$root/puppeteer"
  export PLAYWRIGHT_BROWSERS_PATH="$root/ms-playwright"
  export npm_config_cache="$root/npm"
  export AURDEST="$root/yay"

  # environment.d has no conditionals, so generate it per machine instead of
  # stowing a file with a hardcoded path. This covers the systemd user session
  # and anything it launches; dot-zshenv covers plain TTY/SSH shells.
  mkdir -p "$(dirname "$generated")"
  cat > "$generated" <<EOF
# Generated by bin/install from ~/.config/dotfiles/cache_root. Do not edit.
GOMODCACHE=$root/go/mod
GOCACHE=$root/go/build
UV_CACHE_DIR=$root/uv
PUPPETEER_CACHE_DIR=$root/puppeteer
PLAYWRIGHT_BROWSERS_PATH=$root/ms-playwright
npm_config_cache=$root/npm
AURDEST=$root/yay
EOF

  setup_pacman_cache_dir "$root/pacman/pkg"
}

# Apply cache paths before any downloads or builds can fill the root disk.
if [ "$(uname)" = "Linux" ]; then
  setup_cache_relocation
fi

